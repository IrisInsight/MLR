# All optional. The app runs in demo mode without any of these.

# Model access (pick one):
#   - On Vercel, the AI Gateway authenticates through OIDC automatically; nothing to set.
#   - Elsewhere, set an AI Gateway key:
# AI_GATEWAY_API_KEY=
#   - Or call Anthropic directly (takes precedence when set):
# ANTHROPIC_API_KEY=

# Lead storage: when set, leads are stored as private objects in Vercel Blob.
# BLOB_READ_WRITE_TOKEN=

# Admin: SHA-256 hex of the admin password. The committed default hash is for the
# generated concept password; replace it before real use.
# ADMIN_PASSWORD_SHA256=
